# EarthSight Environment Variables

# Application Settings
PROJECT_NAME="EarthSight Satellite AI Platform"
ENVIRONMENT="production"
LOG_LEVEL="info"

# Backend Server Config
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Satellite Data Access (Optional for Live STAC Mode)
SENTINEL_STAC_URL="https://planetarycomputer.microsoft.com/api/stac/v1/search"
PLANETARY_COMPUTER_API_KEY=""

# Optional LLM API Integration (OpenAI or Gemini for enhanced natural language parsing)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# PostgreSQL / PostGIS Database (Optional for production persistence)
DATABASE_URL="sqlite:///./earth_sight.db"
# POSTGIS_URL="postgresql://user:password@localhost:5432/earthsight_postgis"
